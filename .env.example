PORT=3780
NODE_ENV=development
DATABASE_PATH=./data/company-ai-hub.db

# 32 random bytes, base64 encoded. Generate once and keep it in a secret manager.
APP_ENCRYPTION_KEY=

# Used only when the user table is empty. No default password is built into the app.
ADMIN_EMAIL=admin@example.com
ADMIN_DISPLAY_NAME=Administrator
ADMIN_PASSWORD=

# Local Codex sends this as its provider bearer token. No token-management UI is included.
GATEWAY_BEARER_TOKEN=

# Tests/local loopback only. Production refuses unauthenticated gateway access.
GATEWAY_AUTH_DISABLED=false

# Exact upstream provider hostname allowlist, comma separated.
PROVIDER_HOST_ALLOWLIST=api.openai.com,api.deepseek.com

# Local development only. Keep false in production.
ALLOW_PRIVATE_PROVIDER_HOSTS=false
SESSION_COOKIE_SECURE=false
